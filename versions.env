# What install.py installs. A change here is a new release of rk1-speech; the fleet tool
# rolls it out one board at a time, and rolls back to the previous deploy.

# Speech recognition: https://github.com/fursman/moonshine-rknn (MIT)
MOONSHINE_RKNN_REPO=https://github.com/fursman/moonshine-rknn
MOONSHINE_RKNN_COMMIT=d1822a56242630919a49e25de3933839b14445e0

# Speech synthesis: https://github.com/fursman/kokoro-rknn (Apache-2.0)
KOKORO_RKNN_REPO=https://github.com/fursman/kokoro-rknn
KOKORO_RKNN_COMMIT=e32630f9f33bf14e99d843b93e849236ea4a3b15
# The decoder lengths kokoro-rknn builds and loads (kokoro_rknn/buckets.py).
KOKORO_BUCKETS="64 96 128 160 200 256 320 400"
# Compiles the NPU graphs (kokoro-rknn README: 2.3.2; 2.5.0 is untested for these graphs).
RKNN_TOOLKIT2=2.3.2

# Rockchip's NPU runtime, from the v2.5.0 tag of airockchip/rknn-toolkit2.
LIBRKNNRT_VERSION=2.5.0
LIBRKNNRT_URL=https://raw.githubusercontent.com/airockchip/rknn-toolkit2/v2.5.0/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so
LIBRKNNRT_SHA256=4b6cc575bedf8952b13db4b1190fa3b3d2ac213f00be774ff6ccd19d651970c0

# The RKNPU kernel driver this needs at least (it cannot be installed from here).
RKNPU_DRIVER_MIN=0.9.2

# The Python the engines were measured with; 3.10-3.12 work.
PYTHON_VERSION=3.12
